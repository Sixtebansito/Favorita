generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

model User {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String
  role           String          @default("USER") // ADMIN, USER
  isActive       Boolean         @default(true)
  transportistas Transportista[] @relation("UserTransportistas")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  GuiaPrecio     GuiaPrecio[]
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())
}

model Transportista {
  id            String         @id @default(cuid())
  name          String
  ruc           String         @unique
  users         User[]         @relation("UserTransportistas")
  cabezales     Cabezal[]
  liquidaciones Liquidacion[]
  cierresSemana   CierreSemana[]
  gastos          Gasto[]
  cierresMesGasto CierreMesGasto[]
  createdAt       DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Cabezal {
  id              String        @id @default(cuid())
  placa           String        @unique
  tipo            String        @default("CABEZAL") // CABEZAL, OTAWA
  transportistaId String
  transportista   Transportista @relation(fields: [transportistaId], references: [id], onDelete: Cascade)
  guias           Guia[]
  gastos          Gasto[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Tarifario {
  id             String       @id @default(cuid())
  nombre         String // ej: "Precios Agosto"
  fecha_vigencia DateTime // A partir de qué fecha son válidos
  activo         Boolean      @default(true)
  precios        GuiaPrecio[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model GuiaPrecio {
  id          String    @id @default(cuid())
  tarifarioId String
  tarifario   Tarifario @relation(fields: [tarifarioId], references: [id], onDelete: Cascade)
  userId      String? // Para códigos privados de un usuario específico
  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codigo      String // ej: "123" o "123S"
  tipo        String // "SECO" o "FRIO"
  descripcion String
  valor       Float
  guias       Guia[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Guia {
  id                 String          @id @default(cuid())
  cabezalId          String
  cabezal            Cabezal         @relation(fields: [cabezalId], references: [id], onDelete: Restrict)
  guiaPrecioId       String
  guiaPrecio         GuiaPrecio      @relation(fields: [guiaPrecioId], references: [id], onDelete: Restrict)
  fecha_guia         DateTime // Fecha real de la guía, determina el tarifario a usar
  valor_base_cobrado Float // Snapshot del valor base en ese momento
  cliente_destino    String // ej: "POFASA", "AGROPESA", u otros
  codigos_evaluados  String? // ej: "123, 124, 125S"
  estado             String          @default("ACTIVA") // ACTIVA, CUADRADA, LIQUIDADA
  liquidacionId      String?
  liquidacion        Liquidacion?    @relation(fields: [liquidacionId], references: [id], onDelete: SetNull)
  cierreSemanaId     String?
  cierreSemana       CierreSemana?   @relation(fields: [cierreSemanaId], references: [id], onDelete: SetNull)
  adicionales        GuiaAdicional[]
  valor_ticket       Float           @default(0) // Valor del ticket de la guía
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
}

model CierreSemana {
  id              String        @id @default(cuid())
  transportistaId String
  transportista   Transportista @relation(fields: [transportistaId], references: [id], onDelete: Cascade)
  tipo            String        @default("CABEZAL") // CABEZAL, OTAWA
  fecha_cierre    DateTime      @default(now())
  total           Float
  total_tickets   Float         @default(0)
  guias           Guia[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Liquidacion {
  id              String        @id @default(cuid())
  transportistaId String
  transportista   Transportista @relation(fields: [transportistaId], references: [id], onDelete: Cascade)
  fecha_inicio    DateTime
  fecha_fin       DateTime
  total_pagado    Float
  total_tickets   Float         @default(0)
  guias           Guia[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model GuiaAdicional {
  id        String   @id @default(cuid())
  guiaId    String
  guia      Guia     @relation(fields: [guiaId], references: [id], onDelete: Cascade)
  concepto  String // ej: "Termo King"
  valor     Float // Valor cobrado (puede ser modificado)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AdicionalCatalogo {
  id            String   @id @default(cuid())
  concepto      String   @unique
  valor_defecto Float
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BackupHistory {
  id          String   @id @default(cuid())
  tipo        String   @default("MANUAL") // MANUAL, AUTOMATICO
  enviadoA    String?  // Correo al que se envió (si aplica)
  createdAt   DateTime @default(now())
}

model Configuracion {
  id              String   @id @default(cuid())
  clave           String   @unique // Ej: "BACKUP_CRON"
  valor           String   // JSON stringified o valor simple
  descripcion     String?
  updatedAt       DateTime @updatedAt
}

model Gasto {
  id               String          @id @default(cuid())
  transportistaId  String
  transportista    Transportista   @relation(fields: [transportistaId], references: [id], onDelete: Cascade)
  cabezalId        String?         // Opcional, para asignar el gasto a un camión específico
  cabezal          Cabezal?        @relation(fields: [cabezalId], references: [id], onDelete: SetNull)
  fecha            DateTime
  concepto         String          // Ej: Combustible, Llantas, Peajes, Viáticos, Otros
  descripcion      String?         // Notas adicionales
  valor            Float
  estado           String          @default("ACTIVO") // ACTIVO, CERRADO
  cierreMesGastoId String?
  cierreMesGasto   CierreMesGasto? @relation(fields: [cierreMesGastoId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model CierreMesGasto {
  id              String        @id @default(cuid())
  transportistaId String
  transportista   Transportista @relation(fields: [transportistaId], references: [id], onDelete: Cascade)
  fecha_cierre    DateTime      @default(now())
  mes_referencia  String        // ej: "Agosto 2026"
  total           Float
  gastos          Gasto[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
